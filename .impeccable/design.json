      "refersTo": "field",
      "description": "Ruled, transparent form field with a label above.",
      "html": "<label class=\"ds-label\" for=\"ds-name\">Your name</label><input id=\"ds-name\" class=\"ds-field\" placeholder=\"Name\">",
      "css": ".ds-label{display:block;margin-bottom:8px;font-family:var(--font-sign),sans-serif;font-size:.9375rem;font-weight:650;color:var(--ink);} .ds-field{width:100%;height:52px;padding:0 12px;background:transparent;border:1.5px solid var(--rule);border-radius:4px;font-family:var(--font-sign),sans-serif;font-size:1.0625rem;color:var(--ink);caret-color:var(--line-R);} .ds-field:focus-visible{outline:3px solid hsl(var(--ring));outline-offset:3px;}"
