  "components": [
    {
      "name": "Sign Button",
      "kind": "button",
      "refersTo": "button-sign",
      "description": "The main action on a black sign.",
      "html": "<div class=\"ds-on-sign\"><a class=\"ds-btn-sign\" href=\"#\">See the work <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>",
      "css": ".ds-on-sign{background:var(--sign);padding:24px;} .ds-btn-sign{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;padding:0 18px;font-family:var(--font-sign),sans-serif;font-weight:650;border:0;border-radius:4px;cursor:pointer;transition:transform .2s cubic-bezier(0.16, 1, 0.3, 1),background-color .15s,color .15s,box-shadow .15s;background:var(--sign-ink);color:#0b0e11;text-decoration:none;} .ds-btn-sign:hover{transform:translateY(-2px);} .ds-btn-sign:focus-visible{outline:3px solid hsl(var(--ring));outline-offset:3px;}"
    },
    {
      "name": "Quiet Sign Button",
      "kind": "button",
      "refersTo": "button-sign-quiet",
      "description": "The secondary action on a sign, such as the résumé.",
      "html": "<div class=\"ds-on-sign-q\"><a class=\"ds-btn-quiet\" href=\"#\">Résumé</a></div>",
      "css": ".ds-on-sign-q{background:var(--sign);padding:24px;} .ds-btn-quiet{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;padding:0 18px;font-family:var(--font-sign),sans-serif;font-weight:650;border:0;border-radius:4px;cursor:pointer;transition:transform .2s cubic-bezier(0.16, 1, 0.3, 1),background-color .15s,color .15s,box-shadow .15s;background:transparent;box-shadow:inset 0 0 0 1.5px rgb(255 255 255 / .5);color:var(--sign-ink);text-decoration:none;} .ds-btn-quiet:hover{transform:translateY(-2px);box-shadow:inset 0 0 0 1.5px var(--sign-ink);} .ds-btn-quiet:focus-visible{outline:3px solid hsl(var(--ring));outline-offset:3px;}"
    },
    {
      "name": "Ink Button",
