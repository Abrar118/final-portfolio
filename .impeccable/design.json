    {
      "name": "Station Sign",
      "kind": "card",
      "refersTo": "sign",
      "description": "The black sign at the foot of each map. Its gradient is the current state of an unfinished enamel treatment, not a finished finish.",
      "html": "<section class=\"ds-sign\"><h1 class=\"ds-sign-name\">Abrar Mahir Esam</h1><p class=\"ds-sign-text\">Full-stack software engineer.</p></section>",
      "css": ".ds-sign{background:linear-gradient(180deg,color-mix(in srgb,var(--sign),#fff 9%),var(--sign) 46%);color:var(--sign-ink);padding:22px 24px 26px;border-top:1px solid rgb(255 255 255 / .14);font-family:var(--font-sign),sans-serif;} .ds-sign-name{margin:0;font-size:clamp(3rem,7.2vw,6rem);font-weight:800;font-stretch:104%;line-height:.98;letter-spacing:-.035em;} .ds-sign-text{margin:12px 0 0;font-size:1.0625rem;line-height:1.45;}"
