      "css": ".ds-row{display:grid;grid-template-columns:56px minmax(0,1fr) 88px;gap:8px 28px;align-items:center;padding-block:22px;border-top:6px solid var(--line);color:var(--ink);font-family:var(--font-sign),sans-serif;} .ds-bullet{display:inline-grid;place-items:center;width:3.5rem;height:3.5rem;border-radius:50%;background:var(--line);color:var(--line-ink);font-size:1.75rem;font-weight:800;line-height:1;} .ds-row-title{margin:0;font-size:clamp(1.375rem,2.2vw,1.875rem);font-weight:750;font-stretch:106%;line-height:1.15;letter-spacing:-.015em;} .ds-row-text{margin:0;color:var(--ink-soft);line-height:1.4;} .ds-row-count{margin:0;font-family:var(--font-geist-mono),monospace;font-size:.875rem;text-align:right;color:var(--ink-soft);}"
